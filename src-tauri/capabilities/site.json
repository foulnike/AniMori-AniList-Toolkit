{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "site",
	"description": "Разрешения для окна site — запасного вида с настоящим anilist.co и внедрённым бандлом скрипта: хранилище, буфер обмена, сетевые запросы к API и собственные команды (перезагрузка страницы, полноэкранный режим, открытие внешней ссылки в браузере, диагностика прокси, отметка о том, что страница загрузилась). Команды открытия окон здесь сознательно нет: код чужого сайта не должен плодить окна.",
	"windows": ["site"],
	"local": true,
	"remote": {
		"urls": ["https://anilist.co", "https://*.anilist.co"]
	},
	"permissions": [
		"core:default",
		"store:default",
		"clipboard-manager:allow-write-text",
		"allow-animori-reload",
		"allow-animori-toggle-fullscreen",
		"allow-animori-open-external",
		"allow-animori-proxy-status",
		"allow-animori-proxy-probe",
		"allow-animori-page-ready",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "https://graphql.anilist.co/*" },
				{ "url": "https://shikimori.io/*" },
				{ "url": "https://shikimori.rip/*" },
				{ "url": "https://smotret-anime.online/*" },
				{ "url": "https://anime365.ru/*" },
				{ "url": "https://api.animethemes.moe/*" },
				{ "url": "https://raw.githubusercontent.com/*" },
				{ "url": "https://kodik-api.com/*" },
				{ "url": "https://s4.anilist.co/*" },
				{ "url": "https://kodikplayer.com/*" },
				{ "url": "https://github.com/foulnike/AniMori-AniList-Toolkit/*" }
			]
		}
	]
}
