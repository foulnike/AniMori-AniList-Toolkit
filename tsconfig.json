{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "greasemonkey", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,

    // Этап 2: SFC компилирует vue-tsc, ему нужен preserve.
    "jsx": "preserve",

    "noEmit": true,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Этап 3.4: цель теперь одна и та же, что в resolve.alias в vite.config.ts:
      // мост для браузера. TauriBridge уехал вместе с десктопом, и расходиться
      // двум местам больше негде.
      "@bridge-impl": ["src/bridge/MonkeyBridge"],
      // Пункт 2.10: то же самое для блокировщика рекламы. Цель — заглушки:
      // в браузере рекламу режет расширение пользователя, а десктопная реализация
      // с сетевыми правилами ушла туда же, куда и мост.
      "@adblock-impl": ["src/features/adblock/impl.noop"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
