{
  // Пункт 1.5: сторож границы ядра. Запускается как typecheck:shared.
  //
  // Смысл один: в этой проверке кода надстройки не существует вообще.
  // Если файл из src/shared потянется в src/app — хоть алиасом, хоть
  // относительным путём — модуль не найдётся и проверка упадёт.
  // Общая проверка (typecheck) такую стрелку пропускает: там видно всё дерево.
  //
  // Надстройка теперь одна — src/app. Второй была src/userscript, она уехала
  // в ветку script. Сторож от этого не обессмыслился: ядро должно остаться
  // переносимым — впереди Android, да и сама ветка script живёт на том же ядре.
  //
  // Правило трёх файлов в силе: новый алиас ядра нужно прописать
  // в vite.config.ts, tsconfig.json и здесь.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    // Список умышленно короче общего: только алиасы, ведущие в src/shared.
    // Нет общего @/* — именно он раньше позволял ядру дотянуться
    // до надстройки незаметно.
    //
    // Две строки блокировщика убраны вместе с самим блокировщиком: он жил
    // в ядре ради гибридного окна с чужим сайтом.
    "paths": {
      "@/api/*": ["src/shared/api/*"],
      "@/bridge": ["src/shared/bridge/index"],
      "@/bridge/*": ["src/shared/bridge/*"],
      "@/core/*": ["src/shared/core/*"],
      "@/utils/*": ["src/shared/utils/*"],
      "@bridge-impl": ["src/shared/bridge/TauriBridge"]
    }
  },
  // vite-env.d.ts нужен ради объявлений подставляемых сборкой значений:
  // это описание типов, а не код надстройки.
  "include": ["src/shared/**/*.ts", "src/shared/**/*.d.ts", "src/vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "src-tauri", "src/app"]
}
